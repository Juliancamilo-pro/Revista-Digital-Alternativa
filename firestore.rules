rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 0. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Primitives ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isBootstrapOwnerEmail() {
      return isSignedIn() &&
        ('email' in request.auth.token) &&
        request.auth.token.email.lower() == 'trujillogordillooo@gmail.com';
    }
    function isBootstrappedAdminUid() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/site_meta/bootstrap) &&
        get(/databases/$(database)/documents/site_meta/bootstrap).data.adminUid == request.auth.uid;
    }
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active'
        ) ||
        isBootstrappedAdminUid() ||
        (isBootstrapOwnerEmail() && request.auth.token.email_verified == true)
      );
    }
    function isActiveCollaborator() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'collaborator' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }
    function isOptionalString(data, field, maxLen) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxLen);
    }
    function isOptionalBool(data, field) {
      return !(field in data) || data[field] is bool;
    }
    function isOptionalNumber(data, field, minVal, maxVal) {
      return !(field in data) || (data[field] is number && data[field] >= minVal && data[field] <= maxVal);
    }
    function isValidAdultBirthYear(data) {
      return !('birthYear' in data) || (
        data.birthYear is number &&
        data.birthYear >= 1900 &&
        data.birthYear <= request.time.date().year() - 18
      );
    }
    function hasValidPoliticalConsent(data) {
      return !('politicalAffiliation' in data) ||
        data.politicalAffiliation in ['', 'no', 'yes', 'prefer_not_to_say'] &&
        (
          data.politicalAffiliation != 'yes' ||
          (('politicalConsentAccepted' in data) && data.politicalConsentAccepted == true)
        );
    }
    function isValidInviteTokenRef(hash) {
      return hash is string &&
        hash.size() == 64 &&
        exists(/databases/$(database)/documents/invite_tokens/$(hash)) &&
        get(/databases/$(database)/documents/invite_tokens/$(hash)).data.active == true &&
        (
          !('expiresAt' in get(/databases/$(database)/documents/invite_tokens/$(hash)).data) ||
          get(/databases/$(database)/documents/invite_tokens/$(hash)).data.expiresAt > request.time
        );
    }

    // --- Validation Blueprints ---
    function isValidAdminRole(data) {
      return data.keys().hasAll(['uid', 'role', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'createdAt']) &&
        isValidId(data.uid) &&
        data.role == 'admin' &&
        isOptionalString(data, 'email', 200) &&
        isOptionalString(data, 'displayName', 120) &&
        data.createdAt is timestamp;
    }

    // Public admin identity: NEVER stores birthYear or private consent logs
    function isValidAdminPublicIdentity(data) {
      return data.keys().hasAll(['id', 'identityType', 'name', 'outletType', 'showInDirectory', 'updatedAt']) &&
        data.keys().hasOnly([
          'id', 'identityType', 'name', 'roleTitle', 'outletType',
          'profession', 'jobTitle', 'organization', 'city', 'country', 'publicAge',
          'politicalAffiliation', 'politicalPartyName', 'politicalPartyRole', 'politicalPartyLogoUrl',
          'bio', 'avatarUrl', 'coverUrl', 'websiteUrl', 'socialTwitter', 'socialInstagram', 'socialYoutube',
          'publicEmail', 'location', 'topics',
          'showInDirectory', 'showAvatar', 'showBio', 'showWebsite',
          'showSocialTwitter', 'showSocialInstagram', 'showSocialYoutube',
          'showPublicEmail', 'showLocation', 'showTopics',
          'showProfession', 'showJobTitle', 'showOrganization', 'showCityCountry',
          'showAge', 'showPoliticalAffiliation', 'showPoliticalPartyLogo',
          'updatedAt'
        ]) &&
        data.id in ['owner', 'magazine'] &&
        data.identityType == data.id &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 120 &&
        isOptionalString(data, 'roleTitle', 120) &&
        data.outletType in ['medio', 'independiente'] &&
        isOptionalString(data, 'profession', 120) &&
        isOptionalString(data, 'jobTitle', 120) &&
        isOptionalString(data, 'organization', 140) &&
        isOptionalString(data, 'city', 80) &&
        isOptionalString(data, 'country', 80) &&
        isOptionalNumber(data, 'publicAge', 18, 120) &&
        (!('politicalAffiliation' in data) || data.politicalAffiliation in ['', 'no', 'yes', 'prefer_not_to_say']) &&
        isOptionalString(data, 'politicalPartyName', 140) &&
        isOptionalString(data, 'politicalPartyRole', 120) &&
        isOptionalString(data, 'politicalPartyLogoUrl', 400000) &&
        isOptionalString(data, 'bio', 2000) &&
        isOptionalString(data, 'avatarUrl', 400000) &&
        isOptionalString(data, 'coverUrl', 400000) &&
        isOptionalString(data, 'websiteUrl', 500) &&
        isOptionalString(data, 'socialTwitter', 300) &&
        isOptionalString(data, 'socialInstagram', 300) &&
        isOptionalString(data, 'socialYoutube', 300) &&
        isOptionalString(data, 'publicEmail', 200) &&
        isOptionalString(data, 'location', 120) &&
        (!('topics' in data) || (data.topics is list && data.topics.size() <= 15)) &&
        data.showInDirectory is bool &&
        isOptionalBool(data, 'showAvatar') &&
        isOptionalBool(data, 'showBio') &&
        isOptionalBool(data, 'showWebsite') &&
        isOptionalBool(data, 'showSocialTwitter') &&
        isOptionalBool(data, 'showSocialInstagram') &&
        isOptionalBool(data, 'showSocialYoutube') &&
        isOptionalBool(data, 'showPublicEmail') &&
        isOptionalBool(data, 'showLocation') &&
        isOptionalBool(data, 'showTopics') &&
        isOptionalBool(data, 'showProfession') &&
        isOptionalBool(data, 'showJobTitle') &&
        isOptionalBool(data, 'showOrganization') &&
        isOptionalBool(data, 'showCityCountry') &&
        isOptionalBool(data, 'showAge') &&
        isOptionalBool(data, 'showPoliticalAffiliation') &&
        isOptionalBool(data, 'showPoliticalPartyLogo') &&
        data.updatedAt == request.time;
    }

    function isValidAdminPrivateIdentity(data) {
      return data.keys().hasAll(['id', 'identityType', 'name', 'outletType', 'showInDirectory', 'updatedAt']) &&
        data.keys().hasOnly([
          'id', 'identityType', 'name', 'roleTitle', 'outletType',
          'profession', 'jobTitle', 'organization', 'city', 'country', 'birthYear',
          'politicalAffiliation', 'politicalPartyName', 'politicalPartyRole', 'politicalPartyLogoUrl',
          'politicalConsentAccepted', 'politicalConsentAcceptedAt',
          'bio', 'avatarUrl', 'coverUrl', 'websiteUrl', 'socialTwitter', 'socialInstagram', 'socialYoutube',
          'publicEmail', 'location', 'topics',
          'showInDirectory', 'showAvatar', 'showBio', 'showWebsite',
          'showSocialTwitter', 'showSocialInstagram', 'showSocialYoutube',
          'showPublicEmail', 'showLocation', 'showTopics',
          'showProfession', 'showJobTitle', 'showOrganization', 'showCityCountry',
          'showAge', 'showPoliticalAffiliation', 'showPoliticalPartyLogo',
          'updatedAt'
        ]) &&
        data.id in ['owner', 'magazine'] &&
        data.identityType == data.id &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 120 &&
        isOptionalString(data, 'roleTitle', 120) &&
        data.outletType in ['medio', 'independiente'] &&
        isOptionalString(data, 'profession', 120) &&
        isOptionalString(data, 'jobTitle', 120) &&
        isOptionalString(data, 'organization', 140) &&
        isOptionalString(data, 'city', 80) &&
        isOptionalString(data, 'country', 80) &&
        isValidAdultBirthYear(data) &&
        hasValidPoliticalConsent(data) &&
        isOptionalString(data, 'politicalPartyName', 140) &&
        isOptionalString(data, 'politicalPartyRole', 120) &&
        isOptionalString(data, 'politicalPartyLogoUrl', 400000) &&
        isOptionalBool(data, 'politicalConsentAccepted') &&
        isOptionalString(data, 'politicalConsentAcceptedAt', 60) &&
        isOptionalString(data, 'bio', 2000) &&
        isOptionalString(data, 'avatarUrl', 400000) &&
        isOptionalString(data, 'coverUrl', 400000) &&
        isOptionalString(data, 'websiteUrl', 500) &&
        isOptionalString(data, 'socialTwitter', 300) &&
        isOptionalString(data, 'socialInstagram', 300) &&
        isOptionalString(data, 'socialYoutube', 300) &&
        isOptionalString(data, 'publicEmail', 200) &&
        isOptionalString(data, 'location', 120) &&
        (!('topics' in data) || (data.topics is list && data.topics.size() <= 15)) &&
        data.showInDirectory is bool &&
        isOptionalBool(data, 'showAvatar') &&
        isOptionalBool(data, 'showBio') &&
        isOptionalBool(data, 'showWebsite') &&
        isOptionalBool(data, 'showSocialTwitter') &&
        isOptionalBool(data, 'showSocialInstagram') &&
        isOptionalBool(data, 'showSocialYoutube') &&
        isOptionalBool(data, 'showPublicEmail') &&
        isOptionalBool(data, 'showLocation') &&
        isOptionalBool(data, 'showTopics') &&
        isOptionalBool(data, 'showProfession') &&
        isOptionalBool(data, 'showJobTitle') &&
        isOptionalBool(data, 'showOrganization') &&
        isOptionalBool(data, 'showCityCountry') &&
        isOptionalBool(data, 'showAge') &&
        isOptionalBool(data, 'showPoliticalAffiliation') &&
        isOptionalBool(data, 'showPoliticalPartyLogo') &&
        data.updatedAt == request.time;
    }

    function isValidBootstrapMeta(data) {
      return data.keys().hasAll(['adminClaimed', 'adminUid', 'claimedAt']) &&
        data.keys().hasOnly(['adminClaimed', 'adminUid', 'claimedAt']) &&
        data.adminClaimed == true &&
        isValidId(data.adminUid) &&
        data.claimedAt == request.time;
    }

    function isValidCleanupMeta(data) {
      return data.keys().hasAll(['done', 'cleanedBy', 'cleanedAt']) &&
        data.keys().hasOnly(['done', 'cleanedBy', 'deletedCount', 'cleanedAt']) &&
        data.done is bool &&
        isValidId(data.cleanedBy) &&
        isOptionalNumber(data, 'deletedCount', 0, 5000) &&
        data.cleanedAt == request.time;
    }

    function isValidAdminActivityLog(data) {
      return data.keys().hasAll(['id', 'actorUid', 'actorName', 'action', 'detail', 'createdAt']) &&
        data.keys().hasOnly(['id', 'actorUid', 'actorName', 'action', 'detail', 'createdAt']) &&
        isValidId(data.id) &&
        isValidId(data.actorUid) &&
        data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 120 &&
        data.action is string && data.action.size() >= 2 && data.action.size() <= 120 &&
        data.detail is string && data.detail.size() <= 1000 &&
        data.createdAt == request.time;
    }

    function isValidSiteConfig(data) {
      return data.keys().hasAll(['siteName', 'primaryColor', 'autoApproveCollaborators', 'autoPublishCollaborators', 'allowAnonymousComments', 'commentModerationMode', 'updatedAt']) &&
        data.keys().hasOnly(['siteName', 'tagline', 'logoUrl', 'primaryColor', 'accentColor', 'autoApproveCollaborators', 'autoPublishCollaborators', 'allowAnonymousComments', 'commentModerationMode', 'blockedWords', 'contactEmail', 'aboutText', 'howWeWorkText', 'sourcesPolicyText', 'correctionsPolicyText', 'termsText', 'privacyText', 'authorLiabilityNotice', 'socialLinks', 'heroPostId', 'featuredPostIds', 'homepageSections', 'updatedAt']) &&
        data.siteName is string && data.siteName.size() >= 2 && data.siteName.size() <= 100 &&
        data.primaryColor is string && data.primaryColor.size() >= 4 && data.primaryColor.size() <= 20 &&
        data.autoApproveCollaborators is bool &&
        data.autoPublishCollaborators is bool &&
        data.allowAnonymousComments is bool &&
        data.commentModerationMode in ['post', 'pre'] &&
        isOptionalString(data, 'tagline', 240) &&
        isOptionalString(data, 'logoUrl', 400000) &&
        isOptionalString(data, 'accentColor', 20) &&
        isOptionalString(data, 'contactEmail', 200) &&
        isOptionalString(data, 'aboutText', 15000) &&
        isOptionalString(data, 'howWeWorkText', 15000) &&
        isOptionalString(data, 'sourcesPolicyText', 15000) &&
        isOptionalString(data, 'correctionsPolicyText', 15000) &&
        isOptionalString(data, 'termsText', 15000) &&
        isOptionalString(data, 'privacyText', 15000) &&
        isOptionalString(data, 'authorLiabilityNotice', 3000) &&
        isOptionalString(data, 'heroPostId', 128) &&
        (!('blockedWords' in data) || (data.blockedWords is list && data.blockedWords.size() <= 100)) &&
        (!('featuredPostIds' in data) || (data.featuredPostIds is list && data.featuredPostIds.size() <= 12)) &&
        (!('homepageSections' in data) || (data.homepageSections is list && data.homepageSections.size() <= 20)) &&
        (!('socialLinks' in data) || data.socialLinks is map) &&
        data.updatedAt == request.time;
    }

    function isValidInviteSecret(data) {
      return data.keys().hasAll(['plaintextCode', 'codeHash', 'active', 'updatedAt', 'updatedBy']) &&
        data.keys().hasOnly(['plaintextCode', 'codeHash', 'active', 'expiresAt', 'updatedAt', 'updatedBy']) &&
        data.plaintextCode is string && data.plaintextCode.size() >= 4 && data.plaintextCode.size() <= 64 &&
        data.codeHash is string && data.codeHash.size() == 64 &&
        data.active is bool &&
        (!('expiresAt' in data) || data.expiresAt is timestamp) &&
        isValidId(data.updatedBy) &&
        data.updatedAt == request.time;
    }

    function isValidInviteToken(data) {
      return data.keys().hasAll(['active', 'updatedAt']) &&
        data.keys().hasOnly(['active', 'expiresAt', 'updatedAt']) &&
        data.active is bool &&
        (!('expiresAt' in data) || data.expiresAt is timestamp) &&
        data.updatedAt == request.time;
    }

    function isValidUserAccount(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'status', 'inviteHash', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 120 &&
        data.role in ['admin', 'collaborator', 'reader'] &&
        data.status in ['active', 'pending', 'suspended'] &&
        isOptionalString(data, 'inviteHash', 64) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Public collaborator profile: NEVER stores birthYear or private consent logs
    function isValidCollaboratorPublic(data) {
      return data.keys().hasAll(['uid', 'name', 'outletType', 'status', 'postCount', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'uid', 'name', 'outletType',
          'profession', 'jobTitle', 'organization', 'city', 'country', 'publicAge',
          'politicalAffiliation', 'politicalPartyName', 'politicalPartyRole', 'politicalPartyLogoUrl',
          'bio', 'avatarUrl', 'coverUrl', 'websiteUrl',
          'socialTwitter', 'socialInstagram', 'socialYoutube', 'publicEmail', 'location', 'topics',
          'showInDirectory', 'showAvatar', 'showBio', 'showWebsite',
          'showSocialTwitter', 'showSocialInstagram', 'showSocialYoutube',
          'showPublicEmail', 'showLocation', 'showTopics', 'showJoinDate', 'showPostCount',
          'showProfession', 'showJobTitle', 'showOrganization', 'showCityCountry',
          'showAge', 'showPoliticalAffiliation', 'showPoliticalPartyLogo',
          'directoryHidden', 'directoryFeatured', 'directoryOrder',
          'status', 'inviteHash', 'postCount', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 120 &&
        data.outletType in ['medio', 'independiente'] &&
        data.status in ['active', 'pending', 'suspended'] &&
        data.postCount is number && data.postCount >= 0 &&
        isOptionalString(data, 'profession', 120) &&
        isOptionalString(data, 'jobTitle', 120) &&
        isOptionalString(data, 'organization', 140) &&
        isOptionalString(data, 'city', 80) &&
        isOptionalString(data, 'country', 80) &&
        isOptionalNumber(data, 'publicAge', 18, 120) &&
        (!('politicalAffiliation' in data) || data.politicalAffiliation in ['', 'no', 'yes', 'prefer_not_to_say']) &&
        isOptionalString(data, 'politicalPartyName', 140) &&
        isOptionalString(data, 'politicalPartyRole', 120) &&
        isOptionalString(data, 'politicalPartyLogoUrl', 400000) &&
        isOptionalString(data, 'bio', 2000) &&
        isOptionalString(data, 'avatarUrl', 400000) &&
        isOptionalString(data, 'coverUrl', 400000) &&
        isOptionalString(data, 'websiteUrl', 500) &&
        isOptionalString(data, 'socialTwitter', 300) &&
        isOptionalString(data, 'socialInstagram', 300) &&
        isOptionalString(data, 'socialYoutube', 300) &&
        isOptionalString(data, 'publicEmail', 200) &&
        isOptionalString(data, 'location', 120) &&
        (!('topics' in data) || (data.topics is list && data.topics.size() <= 15)) &&
        isOptionalBool(data, 'showInDirectory') &&
        isOptionalBool(data, 'showAvatar') &&
        isOptionalBool(data, 'showBio') &&
        isOptionalBool(data, 'showWebsite') &&
        isOptionalBool(data, 'showSocialTwitter') &&
        isOptionalBool(data, 'showSocialInstagram') &&
        isOptionalBool(data, 'showSocialYoutube') &&
        isOptionalBool(data, 'showPublicEmail') &&
        isOptionalBool(data, 'showLocation') &&
        isOptionalBool(data, 'showTopics') &&
        isOptionalBool(data, 'showJoinDate') &&
        isOptionalBool(data, 'showPostCount') &&
        isOptionalBool(data, 'showProfession') &&
        isOptionalBool(data, 'showJobTitle') &&
        isOptionalBool(data, 'showOrganization') &&
        isOptionalBool(data, 'showCityCountry') &&
        isOptionalBool(data, 'showAge') &&
        isOptionalBool(data, 'showPoliticalAffiliation') &&
        isOptionalBool(data, 'showPoliticalPartyLogo') &&
        isOptionalBool(data, 'directoryHidden') &&
        isOptionalBool(data, 'directoryFeatured') &&
        isOptionalNumber(data, 'directoryOrder', -1000, 10000) &&
        isOptionalString(data, 'inviteHash', 64) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCollaboratorSettings(data) {
      return data.keys().hasAll(['uid', 'name', 'outletType', 'updatedAt']) &&
        data.keys().hasOnly([
          'uid', 'name', 'outletType',
          'profession', 'jobTitle', 'organization', 'city', 'country', 'birthYear',
          'politicalAffiliation', 'politicalPartyName', 'politicalPartyRole', 'politicalPartyLogoUrl',
          'politicalConsentAccepted', 'politicalConsentAcceptedAt',
          'bio', 'avatarUrl', 'coverUrl', 'websiteUrl',
          'socialTwitter', 'socialInstagram', 'socialYoutube', 'publicEmail', 'location', 'topics',
          'showInDirectory', 'showAvatar', 'showBio', 'showWebsite',
          'showSocialTwitter', 'showSocialInstagram', 'showSocialYoutube',
          'showPublicEmail', 'showLocation', 'showTopics', 'showJoinDate', 'showPostCount',
          'showProfession', 'showJobTitle', 'showOrganization', 'showCityCountry',
          'showAge', 'showPoliticalAffiliation', 'showPoliticalPartyLogo',
          'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 120 &&
        data.outletType in ['medio', 'independiente'] &&
        isOptionalString(data, 'profession', 120) &&
        isOptionalString(data, 'jobTitle', 120) &&
        isOptionalString(data, 'organization', 140) &&
        isOptionalString(data, 'city', 80) &&
        isOptionalString(data, 'country', 80) &&
        isValidAdultBirthYear(data) &&
        hasValidPoliticalConsent(data) &&
        isOptionalString(data, 'politicalPartyName', 140) &&
        isOptionalString(data, 'politicalPartyRole', 120) &&
        isOptionalString(data, 'politicalPartyLogoUrl', 400000) &&
        isOptionalBool(data, 'politicalConsentAccepted') &&
        isOptionalString(data, 'politicalConsentAcceptedAt', 60) &&
        isOptionalString(data, 'bio', 2000) &&
        isOptionalString(data, 'avatarUrl', 400000) &&
        isOptionalString(data, 'coverUrl', 400000) &&
        isOptionalString(data, 'websiteUrl', 500) &&
        isOptionalString(data, 'socialTwitter', 300) &&
        isOptionalString(data, 'socialInstagram', 300) &&
        isOptionalString(data, 'socialYoutube', 300) &&
        isOptionalString(data, 'publicEmail', 200) &&
        isOptionalString(data, 'location', 120) &&
        (!('topics' in data) || (data.topics is list && data.topics.size() <= 15)) &&
        isOptionalBool(data, 'showInDirectory') &&
        isOptionalBool(data, 'showAvatar') &&
        isOptionalBool(data, 'showBio') &&
        isOptionalBool(data, 'showWebsite') &&
        isOptionalBool(data, 'showSocialTwitter') &&
        isOptionalBool(data, 'showSocialInstagram') &&
        isOptionalBool(data, 'showSocialYoutube') &&
        isOptionalBool(data, 'showPublicEmail') &&
        isOptionalBool(data, 'showLocation') &&
        isOptionalBool(data, 'showTopics') &&
        isOptionalBool(data, 'showJoinDate') &&
        isOptionalBool(data, 'showPostCount') &&
        isOptionalBool(data, 'showProfession') &&
        isOptionalBool(data, 'showJobTitle') &&
        isOptionalBool(data, 'showOrganization') &&
        isOptionalBool(data, 'showCityCountry') &&
        isOptionalBool(data, 'showAge') &&
        isOptionalBool(data, 'showPoliticalAffiliation') &&
        isOptionalBool(data, 'showPoliticalPartyLogo') &&
        data.updatedAt == request.time;
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['id', 'name', 'slug', 'order', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'name', 'slug', 'description', 'parentId', 'order', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 80 &&
        data.slug is string && data.slug.size() >= 2 && data.slug.size() <= 100 &&
        isOptionalString(data, 'description', 400) &&
        isOptionalString(data, 'parentId', 128) &&
        data.order is number && data.order >= 0 && data.order <= 1000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSeries(data) {
      return data.keys().hasAll(['id', 'title', 'slug', 'description', 'featured', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'title', 'slug', 'description', 'coverImage', 'featured', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 160 &&
        data.slug is string && data.slug.size() >= 2 && data.slug.size() <= 160 &&
        data.description is string && data.description.size() <= 1200 &&
        isOptionalString(data, 'coverImage', 400000) &&
        data.featured is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPost(data) {
      return data.keys().hasAll(['id', 'title', 'slug', 'type', 'status', 'featured', 'breaking', 'isSample', 'categoryId', 'categoryName', 'categorySlug', 'tags', 'authorId', 'authorName', 'blocks', 'readTimeMinutes', 'viewCount', 'commentCount', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'id', 'title', 'slug', 'subtitle', 'type', 'editorialKind', 'status', 'featured', 'breaking', 'pinnedInFeed', 'isSample',
          'categoryId', 'categoryName', 'categorySlug', 'seriesId', 'seriesTitle', 'tags',
          'authorId', 'authorProfileId', 'authorIdentityType', 'authorVerified', 'authorName', 'authorAvatar', 'authorOutletType',
          'coverImage', 'coverAlt', 'coverCredit', 'coverLayout', 'headerStyle', 'accentColor', 'paragraphIndent',
          'apaMode', 'apaReferences', 'showTableOfContents',
          'blocks', 'galleryItems', 'corrections',
          'keyPoints', 'sensitiveContent', 'sensitiveWarning', 'sources', 'seoDescription', 'commentsEnabled',
          'mediaUrl', 'mediaSourceType', 'mediaChapters', 'mediaTranscript', 'mediaSubtitlesUrl',
          'mediaDurationLabel', 'mediaRelatedLinks', 'episodeNotes', 'seasonNumber', 'episodeNumber',
          'documentTitle', 'audioDurationSec',
          'readTimeMinutes', 'viewCount', 'commentCount', 'publishedAt', 'scheduledFor', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.title is string && data.title.size() >= 3 && data.title.size() <= 220 &&
        data.slug is string && data.slug.size() >= 2 && data.slug.size() <= 240 &&
        isOptionalString(data, 'subtitle', 500) &&
        data.type in ['article', 'gallery', 'video', 'audio', 'infographic', 'document', 'livestream'] &&
        (!('editorialKind' in data) || data.editorialKind in ['articulo', 'investigacion', 'opinion', 'cronica', 'analisis', 'reportaje', 'multimedia', 'entrevista', 'editorial', 'explicativo', 'datos', 'carta']) &&
        data.status in ['draft', 'in_review', 'scheduled', 'published', 'unpublished'] &&
        data.featured is bool &&
        data.breaking is bool &&
        isOptionalBool(data, 'pinnedInFeed') &&
        data.isSample is bool &&
        isValidId(data.categoryId) &&
        data.categoryName is string && data.categoryName.size() <= 80 &&
        data.categorySlug is string && data.categorySlug.size() <= 100 &&
        isOptionalString(data, 'seriesId', 128) &&
        isOptionalString(data, 'seriesTitle', 160) &&
        data.tags is list && data.tags.size() <= 12 &&
        (data.tags.size() == 0 || data.tags[0] is string) &&
        isValidId(data.authorId) &&
        isOptionalString(data, 'authorProfileId', 128) &&
        (!('authorIdentityType' in data) || data.authorIdentityType in ['owner', 'magazine', 'collaborator']) &&
        isOptionalBool(data, 'authorVerified') &&
        data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 120 &&
        isOptionalString(data, 'authorAvatar', 400000) &&
        (!('authorOutletType' in data) || data.authorOutletType in ['medio', 'independiente']) &&
        isOptionalString(data, 'coverImage', 400000) &&
        isOptionalString(data, 'coverAlt', 300) &&
        isOptionalString(data, 'coverCredit', 200) &&
        (!('coverLayout' in data) || data.coverLayout in ['full', 'compact', 'overlay']) &&
        (!('headerStyle' in data) || data.headerStyle in ['classic', 'editorial', 'minimal']) &&
        isOptionalString(data, 'accentColor', 20) &&
        isOptionalBool(data, 'paragraphIndent') &&
        isOptionalBool(data, 'apaMode') &&
        (!('apaReferences' in data) || (data.apaReferences is list && data.apaReferences.size() <= 60)) &&
        isOptionalBool(data, 'showTableOfContents') &&
        data.blocks is list && data.blocks.size() <= 80 &&
        (!('galleryItems' in data) || (data.galleryItems is list && data.galleryItems.size() <= 30)) &&
        (!('corrections' in data) || (data.corrections is list && data.corrections.size() <= 30)) &&
        (!('keyPoints' in data) || (data.keyPoints is list && data.keyPoints.size() <= 10)) &&
        isOptionalBool(data, 'sensitiveContent') &&
        isOptionalString(data, 'sensitiveWarning', 300) &&
        (!('sources' in data) || (data.sources is list && data.sources.size() <= 30)) &&
        isOptionalString(data, 'seoDescription', 320) &&
        isOptionalBool(data, 'commentsEnabled') &&
        isOptionalString(data, 'mediaUrl', 400000) &&
        isOptionalString(data, 'mediaSourceType', 40) &&
        (!('mediaChapters' in data) || (data.mediaChapters is list && data.mediaChapters.size() <= 50)) &&
        isOptionalString(data, 'mediaTranscript', 40000) &&
        isOptionalString(data, 'mediaSubtitlesUrl', 1000) &&
        isOptionalString(data, 'mediaDurationLabel', 40) &&
        (!('mediaRelatedLinks' in data) || (data.mediaRelatedLinks is list && data.mediaRelatedLinks.size() <= 20)) &&
        isOptionalString(data, 'episodeNotes', 10000) &&
        isOptionalNumber(data, 'seasonNumber', 1, 999) &&
        isOptionalNumber(data, 'episodeNumber', 1, 9999) &&
        isOptionalString(data, 'documentTitle', 200) &&
        isOptionalNumber(data, 'audioDurationSec', 0, 86400) &&
        data.readTimeMinutes is number && data.readTimeMinutes >= 1 && data.readTimeMinutes <= 180 &&
        data.viewCount is number && data.viewCount >= 0 &&
        data.commentCount is number && data.commentCount >= 0 &&
        (!('publishedAt' in data) || data.publishedAt is timestamp) &&
        (!('scheduledFor' in data) || data.scheduledFor is timestamp) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAdminPost(data, postId) {
      return data.keys().hasAll(['id', 'title', 'slug', 'type', 'status', 'categoryId', 'authorId', 'blocks', 'tags', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'id', 'title', 'slug', 'subtitle', 'type', 'editorialKind', 'status', 'featured', 'breaking', 'pinnedInFeed', 'isSample',
          'categoryId', 'categoryName', 'categorySlug', 'seriesId', 'seriesTitle', 'tags',
          'authorId', 'authorProfileId', 'authorIdentityType', 'authorVerified', 'authorName', 'authorAvatar', 'authorOutletType',
          'coverImage', 'coverAlt', 'coverCredit', 'coverLayout', 'headerStyle', 'accentColor', 'paragraphIndent',
          'apaMode', 'apaReferences', 'showTableOfContents',
          'blocks', 'galleryItems', 'corrections',
          'keyPoints', 'sensitiveContent', 'sensitiveWarning', 'sources', 'seoDescription', 'commentsEnabled',
          'mediaUrl', 'mediaSourceType', 'mediaChapters', 'mediaTranscript', 'mediaSubtitlesUrl',
          'mediaDurationLabel', 'mediaRelatedLinks', 'episodeNotes', 'seasonNumber', 'episodeNumber',
          'documentTitle', 'audioDurationSec',
          'readTimeMinutes', 'viewCount', 'commentCount', 'publishedAt', 'scheduledFor', 'createdAt', 'updatedAt'
        ]) &&
        data.id == postId &&
        data.title is string && data.title.size() >= 3 && data.title.size() <= 220 &&
        data.slug is string && data.slug.size() >= 2 && data.slug.size() <= 240 &&
        data.type in ['article', 'gallery', 'video', 'audio', 'infographic', 'document', 'livestream'] &&
        data.status in ['draft', 'in_review', 'scheduled', 'published', 'unpublished'] &&
        isValidId(data.categoryId) &&
        isValidId(data.authorId) &&
        data.blocks is list && data.blocks.size() <= 80 &&
        data.tags is list && data.tags.size() <= 12 &&
        data.createdAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidComment(data) {
      return data.keys().hasAll(['id', 'postId', 'postTitle', 'postAuthorId', 'authorName', 'authorIsAnonymous', 'text', 'status', 'likesCount', 'reportCount', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'postId', 'postTitle', 'postAuthorId', 'parentId', 'authorId', 'authorName', 'authorIsAnonymous', 'authorIsAdmin', 'authorProfileId', 'authorAvatar', 'text', 'status', 'likesCount', 'reportCount', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.postId) &&
        data.postTitle is string && data.postTitle.size() <= 220 &&
        isValidId(data.postAuthorId) &&
        isOptionalString(data, 'parentId', 128) &&
        isOptionalString(data, 'authorId', 128) &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80 &&
        data.authorIsAnonymous is bool &&
        isOptionalBool(data, 'authorIsAdmin') &&
        isOptionalString(data, 'authorProfileId', 128) &&
        isOptionalString(data, 'authorAvatar', 400000) &&
        data.text is string && data.text.size() >= 1 && data.text.size() <= 2000 &&
        data.status in ['approved', 'pending', 'hidden', 'spam'] &&
        data.likesCount is number && data.likesCount >= 0 &&
        data.reportCount is number && data.reportCount >= 0 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSubscriber(data) {
      return data.keys().hasAll(['id', 'email', 'createdAt']) &&
        data.keys().hasOnly(['id', 'email', 'name', 'createdAt']) &&
        isValidId(data.id) &&
        data.email is string && data.email.size() >= 5 && data.email.size() <= 200 &&
        isOptionalString(data, 'name', 120) &&
        data.createdAt == request.time;
    }

    function isValidTicket(data) {
      return data.keys().hasAll(['id', 'type', 'reporterName', 'reporterEmail', 'reason', 'details', 'status', 'createdAt']) &&
        data.keys().hasOnly(['id', 'type', 'postId', 'postTitle', 'reporterName', 'reporterEmail', 'reason', 'details', 'status', 'createdAt']) &&
        isValidId(data.id) &&
        data.type in ['denuncia', 'rectificacion'] &&
        isOptionalString(data, 'postId', 128) &&
        isOptionalString(data, 'postTitle', 220) &&
        data.reporterName is string && data.reporterName.size() >= 2 && data.reporterName.size() <= 120 &&
        data.reporterEmail is string && data.reporterEmail.size() >= 5 && data.reporterEmail.size() <= 200 &&
        data.reason is string && data.reason.size() >= 3 && data.reason.size() <= 200 &&
        data.details is string && data.details.size() >= 5 && data.details.size() <= 3000 &&
        data.status in ['pending', 'reviewed', 'resolved'] &&
        data.createdAt == request.time;
    }

    function isValidBookmark(data) {
      return data.keys().hasAll(['postId', 'title', 'slug', 'createdAt']) &&
        data.keys().hasOnly(['postId', 'title', 'slug', 'coverImage', 'categoryName', 'createdAt']) &&
        isValidId(data.postId) &&
        data.title is string && data.title.size() <= 220 &&
        data.slug is string && data.slug.size() <= 240 &&
        isOptionalString(data, 'coverImage', 400000) &&
        isOptionalString(data, 'categoryName', 80) &&
        data.createdAt == request.time;
    }

    function isValidAnalyticsEvent(data) {
      return data.keys().hasAll(['id', 'postId', 'categoryId', 'authorId', 'contentType', 'readDurationSec', 'referrerSource', 'dateKey', 'createdAt']) &&
        data.keys().hasOnly(['id', 'postId', 'categoryId', 'authorId', 'contentType', 'readDurationSec', 'referrerSource', 'dateKey', 'createdAt']) &&
        isValidId(data.id) &&
        isValidId(data.postId) &&
        isValidId(data.categoryId) &&
        isValidId(data.authorId) &&
        data.contentType in ['article', 'gallery', 'video', 'audio', 'infographic', 'document', 'livestream'] &&
        data.readDurationSec is number && data.readDurationSec >= 0 && data.readDurationSec <= 7200 &&
        data.referrerSource is string && data.referrerSource.size() <= 80 &&
        data.dateKey is string && data.dateKey.size() == 10 &&
        data.createdAt == request.time;
    }

    function isValidBlockedCommenter(data) {
      return data.keys().hasAll(['id', 'targetName', 'createdAt']) &&
        data.keys().hasOnly(['id', 'targetUid', 'targetName', 'reason', 'createdAt']) &&
        isValidId(data.id) &&
        isOptionalString(data, 'targetUid', 128) &&
        data.targetName is string && data.targetName.size() >= 1 && data.targetName.size() <= 120 &&
        isOptionalString(data, 'reason', 300) &&
        data.createdAt == request.time;
    }

    // --- Collection Rules ---

    // Connection check doc
    match /test/{docId} {
      allow get: if isValidId(docId);
      allow list, write: if false;
    }

    // First-admin bootstrap lock (Preserved intact, restricted to owner email or active admin)
    match /site_meta/bootstrap {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn() &&
        !exists(/databases/$(database)/documents/site_meta/bootstrap) &&
        isValidBootstrapMeta(incoming()) &&
        incoming().adminUid == request.auth.uid &&
        (isAdmin() || isBootstrapOwnerEmail());
      allow update, delete: if false;
    }

    // One-time sample cleanup state (Admin only)
    match /site_meta/cleanup {
      allow get: if isAdmin();
      allow list: if false;
      allow create, update: if isAdmin() && isValidCleanupMeta(incoming());
      allow delete: if false;
    }

    // Immutable Admin Activity Logs
    match /admin_activity_logs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(logId) &&
        isAdmin() &&
        isValidAdminActivityLog(incoming()) &&
        incoming().id == logId &&
        incoming().actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Admins (Preserved intact)
    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isValidId(userId) &&
        isSignedIn() &&
        isValidAdminRole(incoming()) &&
        incoming().uid == userId &&
        (
          isAdmin() ||
          (isOwner(userId) && isBootstrapOwnerEmail() && !exists(/databases/$(database)/documents/site_meta/bootstrap))
        );
      allow update, delete: if isValidId(userId) && isAdmin();
    }

    // Public Editorial Identities for Owner & Magazine (Admin writes only, zero PII/birthYear exposed)
    match /admin_identities/{identityId} {
      allow get: if identityId in ['owner', 'magazine'];
      allow list: if true;
      allow create, update: if identityId in ['owner', 'magazine'] &&
        isAdmin() &&
        isValidAdminPublicIdentity(incoming()) &&
        incoming().id == identityId;
      allow delete: if false;
    }

    // Strictly Private Admin Identities (birthYear, Ley 1581 consent, hidden draft fields)
    match /admin_private/{identityId} {
      allow get, list: if isAdmin();
      allow create, update: if identityId in ['owner', 'magazine'] &&
        isAdmin() &&
        isValidAdminPrivateIdentity(incoming()) &&
        incoming().id == identityId;
      allow delete: if identityId in ['owner', 'magazine'] && isAdmin();
    }

    // Public Site Config
    match /site_config/main {
      allow get: if true;
      allow list: if false;
      allow create: if isAdmin() && isValidSiteConfig(incoming());
      allow update: if isAdmin() && isValidSiteConfig(incoming());
      allow delete: if false;
    }

    // Admin-only Invite Secret
    match /site_secrets/invite {
      allow get, create, update, delete: if isAdmin() && (
        request.method == 'get' || request.method == 'delete' || isValidInviteSecret(incoming())
      );
      allow list: if false;
    }

    // Non-listable SHA-256 Invite Token Lookup
    match /invite_tokens/{codeHash} {
      allow get: if codeHash is string && codeHash.size() == 64;
      allow list: if false;
      allow create, update: if codeHash is string && codeHash.size() == 64 && isAdmin() && isValidInviteToken(incoming());
      allow delete: if codeHash is string && codeHash.size() == 64 && isAdmin();
    }

    // Private User Accounts (PII isolated)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isValidId(userId) &&
        isSignedIn() &&
        isOwner(userId) &&
        isValidUserAccount(incoming()) &&
        incoming().uid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          (incoming().role == 'reader' && incoming().status == 'active') ||
          (
            incoming().role == 'collaborator' &&
            'inviteHash' in incoming() &&
            isValidInviteTokenRef(incoming().inviteHash) &&
            (
              incoming().status == 'pending' ||
              (
                incoming().status == 'active' &&
                exists(/databases/$(database)/documents/site_config/main) &&
                get(/databases/$(database)/documents/site_config/main).data.autoApproveCollaborators == true
              )
            )
          ) ||
          (
            incoming().role == 'admin' &&
            incoming().status == 'active' &&
            (isAdmin() || (isBootstrapOwnerEmail() && !exists(/databases/$(database)/documents/site_meta/bootstrap)))
          )
        );
      allow update: if isValidId(userId) &&
        isValidUserAccount(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            isOwner(userId) &&
            isBootstrapOwnerEmail() &&
            !exists(/databases/$(database)/documents/site_meta/bootstrap) &&
            incoming().role == 'admin' &&
            incoming().status == 'active'
          ) ||
          (
            isOwner(userId) &&
            incoming().role == existing().role &&
            incoming().status == existing().status &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt'])
          )
        );
      allow delete: if isValidId(userId) && isAdmin();

      // Reader Bookmarks
      match /bookmarks/{postId} {
        allow get: if isValidId(userId) && isValidId(postId) && isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isValidId(userId) && isValidId(postId) && isOwner(userId) && isValidBookmark(incoming()) && incoming().postId == postId;
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(postId) && isOwner(userId);
      }
    }

    // Public Opt-In Collaborator & Media Outlet Profiles (NEVER birthYear or private consent)
    match /collaborators_public/{userId} {
      allow get: if isValidId(userId) && (resource.data.status == 'active' || isOwner(userId) || isAdmin());
      allow list: if resource.data.status == 'active' || (isSignedIn() && resource.data.uid == request.auth.uid) || isAdmin();
      allow create: if isValidId(userId) &&
        isSignedIn() &&
        isOwner(userId) &&
        isValidCollaboratorPublic(incoming()) &&
        incoming().uid == request.auth.uid &&
        incoming().postCount == 0 &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            'inviteHash' in incoming() &&
            isValidInviteTokenRef(incoming().inviteHash) &&
            (!('directoryHidden' in incoming()) || incoming().directoryHidden == false) &&
            (!('directoryFeatured' in incoming()) || incoming().directoryFeatured == false) &&
            !('directoryOrder' in incoming())
          )
        );
      allow update: if isValidId(userId) &&
        isValidCollaboratorPublic(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            isOwner(userId) &&
            existing().status == 'active' &&
            incoming().status == existing().status &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'outletType',
              'profession', 'jobTitle', 'organization', 'city', 'country', 'publicAge',
              'politicalAffiliation', 'politicalPartyName', 'politicalPartyRole', 'politicalPartyLogoUrl',
              'bio', 'avatarUrl', 'coverUrl', 'websiteUrl',
              'socialTwitter', 'socialInstagram', 'socialYoutube', 'publicEmail', 'location', 'topics',
              'showInDirectory', 'showAvatar', 'showBio', 'showWebsite',
              'showSocialTwitter', 'showSocialInstagram', 'showSocialYoutube',
              'showPublicEmail', 'showLocation', 'showTopics', 'showJoinDate', 'showPostCount',
              'showProfession', 'showJobTitle', 'showOrganization', 'showCityCountry',
              'showAge', 'showPoliticalAffiliation', 'showPoliticalPartyLogo',
              'updatedAt'
            ])
          ) ||
          (
            isOwner(userId) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['postCount', 'updatedAt'])
          )
        );
      allow delete: if isValidId(userId) && isAdmin();
    }

    // Private Collaborator Settings & Draft Profile (Never public - contains birthYear and Ley 1581 consent)
    match /collaborator_settings/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isValidId(userId) &&
        (isOwner(userId) || isAdmin()) &&
        isValidCollaboratorSettings(incoming()) &&
        incoming().uid == userId;
      allow delete: if isValidId(userId) && isAdmin();
    }

    // Categories
    match /categories/{categoryId} {
      allow get: if isValidId(categoryId);
      allow list: if true;
      allow create: if isValidId(categoryId) &&
        isAdmin() &&
        isValidCategory(incoming()) &&
        incoming().id == categoryId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(categoryId) &&
        isAdmin() &&
        isValidCategory(incoming()) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isValidId(categoryId) && isAdmin();
    }

    // Series & Dossiers
    match /series/{seriesId} {
      allow get: if isValidId(seriesId);
      allow list: if true;
      allow create: if isValidId(seriesId) &&
        isAdmin() &&
        isValidSeries(incoming()) &&
        incoming().id == seriesId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(seriesId) &&
        isAdmin() &&
        isValidSeries(incoming()) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isValidId(seriesId) && isAdmin();
    }

    // Posts (Articles, Galleries, Videos, Audio, Infographics, Documents)
    match /posts/{postId} {
      allow get: if isValidId(postId) && (
        resource.data.status == 'published' ||
        (isSignedIn() && resource.data.authorId == request.auth.uid) ||
        isAdmin()
      );
      allow list: if resource.data.status == 'published' ||
        (isSignedIn() && resource.data.authorId == request.auth.uid) ||
        isAdmin();
      allow create: if isValidId(postId) && (
        (
          isAdmin() &&
          isValidAdminPost(incoming(), postId) &&
          incoming().createdAt == request.time
        ) ||
        (
          isActiveCollaborator() &&
          isValidPost(incoming()) &&
          incoming().id == postId &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          incoming().authorId == request.auth.uid &&
          (!('authorIdentityType' in incoming()) || incoming().authorIdentityType == 'collaborator') &&
          (!('authorProfileId' in incoming()) || incoming().authorProfileId == request.auth.uid) &&
          incoming().featured == false &&
          incoming().breaking == false &&
          (!('pinnedInFeed' in incoming()) || incoming().pinnedInFeed == false) &&
          incoming().isSample == false &&
          incoming().viewCount == 0 &&
          incoming().commentCount == 0 &&
          (
            incoming().status in ['draft', 'in_review', 'scheduled'] ||
            (
              incoming().status == 'published' &&
              (
                !exists(/databases/$(database)/documents/site_config/main) ||
                get(/databases/$(database)/documents/site_config/main).data.autoPublishCollaborators == true
              )
            )
          )
        )
      );
      allow update: if isValidId(postId) && (
        (
          isAdmin() &&
          isValidAdminPost(incoming(), postId) &&
          (
            incoming().createdAt == existing().createdAt ||
            !('createdAt' in existing()) ||
            !(existing().createdAt is timestamp)
          )
        ) ||
        (
          isActiveCollaborator() &&
          isValidPost(incoming()) &&
          incoming().id == existing().id &&
          incoming().createdAt == existing().createdAt &&
          existing().authorId == request.auth.uid &&
          incoming().authorId == existing().authorId &&
          (!('authorIdentityType' in incoming()) || incoming().authorIdentityType == 'collaborator') &&
          (!('authorProfileId' in incoming()) || incoming().authorProfileId == request.auth.uid) &&
          incoming().updatedAt == request.time &&
          incoming().featured == existing().featured &&
          incoming().breaking == existing().breaking &&
          (
            (!('pinnedInFeed' in existing()) && (!('pinnedInFeed' in incoming()) || incoming().pinnedInFeed == false)) ||
            ('pinnedInFeed' in existing() && 'pinnedInFeed' in incoming() && incoming().pinnedInFeed == existing().pinnedInFeed)
          ) &&
          incoming().viewCount == existing().viewCount &&
          incoming().commentCount == existing().commentCount &&
          (
            incoming().status in ['draft', 'in_review', 'scheduled', 'unpublished'] ||
            (
              incoming().status == 'published' &&
              (
                !exists(/databases/$(database)/documents/site_config/main) ||
                get(/databases/$(database)/documents/site_config/main).data.autoPublishCollaborators == true
              )
            )
          )
        ) ||
        (
          isValidPost(incoming()) &&
          incoming().id == existing().id &&
          incoming().createdAt == existing().createdAt &&
          existing().status == 'published' &&
          incoming().diff(existing()).affectedKeys().hasOnly(['viewCount']) &&
          incoming().viewCount == existing().viewCount + 1
        ) ||
        (
          isValidPost(incoming()) &&
          incoming().id == existing().id &&
          incoming().createdAt == existing().createdAt &&
          existing().status == 'published' &&
          incoming().diff(existing()).affectedKeys().hasOnly(['commentCount']) &&
          incoming().commentCount == existing().commentCount + 1
        )
      );
      allow delete: if isValidId(postId) && (
        isAdmin() ||
        (isSignedIn() && existing().authorId == request.auth.uid)
      );
    }

    // Legacy archived livestreams preserved intact without public exposure (Admin read/cleanup only)
    match /livestreams/{streamId} {
      allow get, list, write: if isAdmin();

      match /chat/{messageId} {
        allow get, list, write: if isAdmin();
      }

      match /signals/{signalId} {
        allow get, list, write: if isAdmin();
      }
    }

    // Comments
    match /comments/{commentId} {
      allow get: if isValidId(commentId) && (
        resource.data.status == 'approved' ||
        isAdmin() ||
        (isSignedIn() && resource.data.postAuthorId == request.auth.uid) ||
        (isSignedIn() && resource.data.authorId == request.auth.uid)
      );
      allow list: if resource.data.status == 'approved' ||
        isAdmin() ||
        (isSignedIn() && resource.data.postAuthorId == request.auth.uid) ||
        (isSignedIn() && resource.data.authorId == request.auth.uid);
      allow create: if isValidId(commentId) &&
        isValidComment(incoming()) &&
        incoming().id == commentId &&
        incoming().likesCount == 0 &&
        incoming().reportCount == 0 &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (!('authorIsAdmin' in incoming()) || incoming().authorIsAdmin == false || isAdmin()) &&
        (
          (isSignedIn() && incoming().authorIsAnonymous == false && incoming().authorId == request.auth.uid) ||
          (
            incoming().authorIsAnonymous == true &&
            (
              !exists(/databases/$(database)/documents/site_config/main) ||
              get(/databases/$(database)/documents/site_config/main).data.allowAnonymousComments == true
            )
          )
        ) &&
        (
          (
            (
              !exists(/databases/$(database)/documents/site_config/main) ||
              get(/databases/$(database)/documents/site_config/main).data.commentModerationMode == 'post'
            ) &&
            incoming().status == 'approved'
          ) ||
          (
            exists(/databases/$(database)/documents/site_config/main) &&
            get(/databases/$(database)/documents/site_config/main).data.commentModerationMode == 'pre' &&
            incoming().status == 'pending'
          ) ||
          isAdmin()
        );
      allow update: if isValidId(commentId) &&
        isValidComment(incoming()) &&
        incoming().id == existing().id &&
        incoming().postId == existing().postId &&
        incoming().postAuthorId == existing().postAuthorId &&
        incoming().createdAt == existing().createdAt &&
        (
          (
            (isAdmin() || (isSignedIn() && existing().postAuthorId == request.auth.uid)) &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          ) ||
          (
            existing().status == 'approved' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'reportCount', 'updatedAt']) &&
            incoming().likesCount >= existing().likesCount &&
            incoming().likesCount <= existing().likesCount + 1 &&
            incoming().reportCount >= existing().reportCount &&
            incoming().reportCount <= existing().reportCount + 1
          )
        );
      allow delete: if isValidId(commentId) && (
        isAdmin() ||
        (isSignedIn() && existing().postAuthorId == request.auth.uid) ||
        (isSignedIn() && existing().authorId == request.auth.uid)
      );
    }

    // Newsletter Subscribers (PII protected)
    match /newsletter_subscribers/{subscriberId} {
      allow get, list, delete: if isAdmin();
      allow create: if isValidId(subscriberId) &&
        isValidSubscriber(incoming()) &&
        incoming().id == subscriberId;
      allow update: if false;
    }

    // Content Reports & Rectifications (PII protected)
    match /reports_and_rectifications/{ticketId} {
      allow get, list, delete: if isAdmin();
      allow create: if isValidId(ticketId) &&
        isValidTicket(incoming()) &&
        incoming().id == ticketId &&
        incoming().status == 'pending';
      allow update: if isValidId(ticketId) &&
        isAdmin() &&
        isValidTicket(incoming()) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status']);
    }

    // Privacy-Safe Analytics Events
    match /analytics_events/{eventId} {
      allow get: if isValidId(eventId) && (isAdmin() || (isSignedIn() && resource.data.authorId == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.authorId == request.auth.uid);
      allow create: if isValidId(eventId) && isValidAnalyticsEvent(incoming()) && incoming().id == eventId;
      allow update, delete: if isAdmin();
    }

    // Blocked Commenters
    match /blocked_commenters/{entryId} {
      allow get, list, delete: if isAdmin();
      allow create: if isValidId(entryId) && isAdmin() && isValidBlockedCommenter(incoming()) && incoming().id == entryId;
      allow update: if false;
    }
  }
}
